{
  "name": "n8n-nodes-olaverse",
  "version": "0.1.1",
  "description": "n8n node for Olaverse: document extraction with calibrated confidence, decisions, language ID in 608 languages and diacritics, built for English and African languages",
  "license": "MIT",
  "homepage": "https://docs.olaverselab.com",
  "keywords": [
    "n8n-community-node-package",
    "olaverse",
    "document-extraction",
    "ocr",
    "receipts",
    "invoices",
    "language-detection",
    "african-languages"
  ],
  "author": {
    "name": "Olaverse Ltd",
    "email": "support@olaverselab.com",
    "url": "https://www.olaverselab.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Olaverse-Labs/n8n-nodes-olaverse.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OlaverseApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Olaverse/Olaverse.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.46.5",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
